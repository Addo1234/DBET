<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DBET VIP Predictions</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#111;
color:white;
}

header{
background:#008a3d;
padding:20px;
text-align:center;
}

nav{
background:#000;
padding:15px;
text-align:center;
}

nav a{
color:white;
text-decoration:none;
margin:0 15px;
font-weight:bold;
}

.hero{
padding:60px 20px;
text-align:center;
background:#1a1a1a;
}

.hero h1{
font-size:40px;
color:#00ff88;
}

.btn{
display:inline-block;
margin-top:15px;
padding:12px 25px;
background:#008a3d;
color:white;
text-decoration:none;
border-radius:6px;
}

.section{
padding:30px 20px;
}

.card{
background:#222;
padding:20px;
border-radius:10px;
margin-bottom:15px;
}

.match{
font-size:20px;
font-weight:bold;
}

.prediction{
color:#00ff88;
margin-top:10px;
}

.vip{
background:#ff9800;
color:black;
}

footer{
background:black;
padding:20px;
text-align:center;
margin-top:30px;
}
</style>
</head>

<body>

<header>
<h1>DBET VIP</h1>
<p>Football Predictions & VIP Tips</p>
</header>

<nav>
<a href="#home">Home</a>
<a href="#predictions">Predictions</a>
<a href="#vip">VIP</a>
<a href="#results">Results</a>
<a href="#contact">Contact</a>
</nav>

<section class="hero" id="home">
<h1>Daily Football Predictions</h1>
<p>Get today's football tips and VIP predictions.</p>
<a href="#vip" class="btn">View VIP Tips</a>
</section>

<section class="section" id="predictions">
<h2>Today's Predictions</h2>

<div class="card">
<div class="match">Arsenal vs Chelsea</div>
<div class="prediction">Prediction: Arsenal Win</div>
</div>

<div class="card">
<div class="match">Barcelona vs Sevilla</div>
<div class="prediction">Prediction: Over 2.5 Goals</div>
</div>

<div class="card">
<div class="match">Bayern Munich vs Dortmund</div>
<div class="prediction">Prediction: Both Teams To Score</div>
</div>

</section>

<section class="section" id="vip">
<h2>VIP Predictions</h2>

<div class="card vip">
<h3>VIP Match 1</h3>
<p>Premium prediction available here.</p>
</div>

<div class="card vip">
<h3>VIP Match 2</h3>
<p>Add your VIP tips here.</p>
</div>

</section>

<section class="section" id="results">
<h2>Recent Results</h2>

<div class="card">
<p>Arsenal vs Chelsea - WON ✅</p>
</div>

<div class="card">
<p>Barcelona vs Sevilla - WON ✅</p>
</div>

</section>

<section class="section" id="contact">
<h2>Contact</h2>

<div class="card">
<p>Telegram: Add your Telegram link</p>
<p>WhatsApp: 0531530223</p>
<p>Email: alfredaddo18@icloud.com</p>
</div>

</section>

<footer>
© 2026 DBET VIP Predictions
</footer>

</body>
</html>
